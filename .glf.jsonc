{
  // Licenses of the npm packages bundled into dist/*.cjs, report/dist/main.cjs and
  // the images' report-action.js, which carry this file in /opt/buildcage/licenses/.
  // Regenerated by `vp run build` via licenses/gen-license-file.mjs; the images'
  // other bundled software is listed by hand in THIRD_PARTY_LICENSES instead.
  "inputs": ["./package.json"],
  "output": "./THIRD_PARTY_LICENSES_NPM",
  "lineEnding": "lf",

  // buffers@0.1.1 publishes no license text at all, so there is nothing to
  // collect and the generator would silently drop it. The key pins the version:
  // a bump stops matching, and the missing text fails the build again so the
  // new version gets looked at rather than inheriting this note.
  "replace": {
    "buffers@0.1.1": "./licenses/buffers.txt",
  },
}
