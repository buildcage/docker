{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "description": [
    "ignorePaths is spelled out because config:recommended's :ignoreModulesAndTests preset ignores **/test/**, and every fixture image and probe pin lives under test/. Left to the preset they are managed by nothing, so they drift behind the engine images' own base.",
    "lockFileMaintenance is how transitive dependencies get updated at all. Renovate cannot apply minimumReleaseAge to it; pnpm does, from pnpm-workspace.yaml, when it regenerates the lockfile."
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__fixtures__/**"
  ],
  "schedule": ["* * * * 6"],
  "minimumReleaseAge": "14 days",
  "lockFileMaintenance": { "enabled": true, "schedule": ["* * * * 6"] },
  "internalChecksFilter": "strict",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^docker/universal/Dockerfile$/", "/^docker/inspect/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nARG CNI_VERSION=(?<currentValue>v[\\d.]+)",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nARG COREDNS_VERSION=(?<currentValue>[\\d.]+)",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nARG HAPROXY_ALPINE_BRANCH=(?<currentValue>[\\d.]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^test/helpers\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nTEST_ALPINE_IMAGE=\"[^:]+:(?<currentValue>[\\d.]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nMOBY_PROFILES_SECCOMP_VERSION \\?= (?<currentValue>v[\\d.]+)",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nTEST_[A-Z0-9_]+_IMAGE \\?= [^:\\s]+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.md$/"],
      "matchStrings": [
        "uses: (?<depName>[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+)(?:/[^@\\s]+)?@(?<currentDigest>[a-f0-9]{40}) # (?<currentValue>v[0-9.]+)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Self-referencing actions (buildcage/docker*) are exempt from minimumReleaseAge, matching the previous Dependabot cooldown exclusion, and from the weekly schedule, so a new release lands right away.",
      "matchPackageNames": ["/^buildcage\\/docker/"],
      "minimumReleaseAge": "0 days",
      "schedule": ["at any time"]
    },
    {
      "description": "@vitest/coverage-v8 must equal the vitest that vite-plus bundles, which Renovate cannot see, so pin it by hand when upgrading vite-plus instead of letting Renovate bump it.",
      "matchPackageNames": ["@vitest/coverage-v8"],
      "enabled": false
    },
    {
      "description": "buildcage-runc builds this fork through a replace. The fork also has upstream's tags, which semver ranks above the -buildcage.N prereleases, so only those are candidates. The tags are ours, so no release-age wait.",
      "matchDatasources": ["go"],
      "matchPackageNames": ["github.com/buildcage/go-pkcs12"],
      "allowedVersions": "/-buildcage\\.\\d+$/",
      "ignoreUnstable": false,
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "eclipse-temurin 17 is the JKS case of the Java tests, so it stays on 17.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["eclipse-temurin"],
      "matchCurrentValue": "/^17$/",
      "allowedVersions": "<18"
    },
    {
      "description": "Overridden by the replace above. An upstream release arrives as a new fork tag instead.",
      "matchDatasources": ["go"],
      "matchPackageNames": ["software.sslmate.com/src/go-pkcs12"],
      "enabled": false
    }
  ]
}
