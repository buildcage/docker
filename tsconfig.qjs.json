{
  "compilerOptions": {
    "allowJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "src/core/scripts/**/*.ts",
    "src/core/lib/acl/**/*.ts",
    "src/core/lib/test/**/*.ts",
    "docker/explicit/scripts/**/*.ts",
    "docker/inspect/scripts/**/*.ts"
  ],
  "exclude": ["**/*.property.test.ts", "**/*.node.ts"]
}
