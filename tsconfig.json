{
  "compilerOptions": {
    "allowJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "core/lib/**/*.ts",
    "setup/src/**/*.ts",
    "run/src/**/*.ts",
    "report/src/**/*.ts"
  ],
  "exclude": ["setup/docker", "**/dist/**"]
}
