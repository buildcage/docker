{
  "compilerOptions": {
    "allowJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/core/lib/**/*.ts",
    "src/**/*.ts",
    "report/src/**/*.ts",
    "docker/*/scripts/*.node.ts",
    "docker/lib/**/*.ts"
  ],
  "exclude": ["**/dist/**", "src/core/scripts/**"]
}
