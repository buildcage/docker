{
  "compilerOptions": {
    "allowJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "core/lib/**/*.ts",
    "core/shared/lib/**/*.ts",
    "core/shared/test/test-shim.ts",
    "core/scripts/lib/**/*.ts",
    "setup/src/**/*.ts",
    "run/src/**/*.ts",
    "report/src/**/*.ts"
  ],
  "exclude": [
    "core/shared/lib/rules.test.ts",
    "core/shared/lib/aggregate.test.ts",
    "core/shared/lib/parse-identifier.test.ts",
    "core/scripts/lib/log-parser.test.ts",
    "setup/docker",
    "**/dist/**"
  ]
}
