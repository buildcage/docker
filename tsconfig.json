{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "core/lib/**/*.js",
    "core/lib/**/*.ts",
    "setup/src/**/*.js",
    "setup/src/**/*.ts",
    "run/src/**/*.js",
    "run/src/**/*.ts",
    "report/src/**/*.js",
    "report/src/**/*.ts"
  ],
  "exclude": ["core/shared", "core/scripts", "setup/docker", "**/dist/**"]
}
