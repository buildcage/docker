#!/command/with-contenv sh
set -e

# BuildKit's OCI worker needs a writable /sys/fs/cgroup to make a cgroup per RUN
# step. Remounting, rather than bind-mounting the host's cgroupfs, keeps the
# writable tree inside this container's own cgroup namespace.

# A v1 host passes the remount below and still leaves its per-controller mounts
# read-only, so the exit status alone is not enough to go on.
if [ ! -e /sys/fs/cgroup/cgroup.controllers ]; then
  echo "init-cgroup: /sys/fs/cgroup is not a cgroup v2 mount; buildcage needs a cgroup v2 host" >&2
  exit 1
fi

# busybox mount won't resolve a lone mountpoint against /proc/mounts, hence the
# source. The flags are restated because a remount drops the ones it omits.
mount -o remount,rw,nosuid,nodev,noexec,relatime cgroup /sys/fs/cgroup

# Fail here rather than leave buildkitd to fail at the first RUN step.
if ! mkdir /sys/fs/cgroup/buildcage-probe 2>/dev/null; then
  echo "init-cgroup: /sys/fs/cgroup is still read-only after remounting it" >&2
  exit 1
fi
rmdir /sys/fs/cgroup/buildcage-probe

echo "init-cgroup: /sys/fs/cgroup remounted read-write within this container's cgroup namespace"
