#!/usr/bin/execlineb -P
# haproxy's threads write each line into its ring without waiting, and the
# ring's forwarder streams them here. -1 tells s6-rc the socket is listening,
# so haproxy starts after it; haproxy drops root before it connects, hence
# -a 0666. One connection at a time, as two s6-log cannot share a directory.
#
# s: rotate current at 1MB rather than s6-log's own default of ~100KB, so a
# run with a lot of traffic doesn't rotate mid-run. n: keep 100 rotated
# segments (100MB) rather than the default 10, for the same reason. report
# reads every segment, oldest first, so this is a safety margin, not the only
# thing standing between a busy run and a truncated report. l: split a line
# only past 32768 rather than s6-log's own default of 8192, which sits under
# the length haproxy is configured to write and would cut a long URL in half
# here instead.
fdmove 1 3
s6-ipcserver -1 -c 1 -a 0666 /var/run/haproxy-log.sock
s6-log -l 32768 s1000000 n100 /var/log/haproxy
