load_module /usr/lib/nginx/modules/ngx_stream_module.so;

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

stream {
    # Configure DNS resolver
    resolver ${EXTERNAL_RESOLVER};
    resolver_timeout 5s;

    log_format basic '[$time_local] '
                    '[$access_decision] '
                    '$protocol $status $bytes_sent $bytes_received '
                    '$session_time "$ssl_preread_server_name:$server_port"';

    access_log /dev/stdout basic;
    error_log /var/log/nginx/error_stream.log;

    # Dynamic config: mode=${PROXY_MODE}, HTTP domains=${ALLOWED_HTTP_DOMAINS}, HTTPS domains=${ALLOWED_HTTPS_DOMAINS}

    # Allowlist map (with wildcard support)
    map $ssl_preread_server_name $is_allowed_https {
        hostnames;
        # Dynamically generated allowlist
${NGINX_HTTPS_ALLOWED_MAP}
        # Default behavior
        default                     ${NGINX_HTTPS_DEFAULT_ALLOWED};
    }

    # Backend determination (dynamic resolution if allowed, otherwise block)
    map $is_allowed_https $https_backend {
        1       $ssl_preread_server_name:$server_port;
        default 127.0.0.1:65535;
    }

    # Log the allow/block/audit decision result
    map $is_allowed_https $access_decision {
        0       "BLOCKED";
        default "${NGINX_ACCESS_DECISION}";
    }

    # HTTPS proxy server
    server {
${NGINX_HTTPS_LISTEN}
        ssl_preread on;
        proxy_pass $https_backend;
        proxy_timeout 10s;
    }
}

# HTTP block (proxy + health check)
http {
    # Configure DNS resolver
    resolver ${EXTERNAL_RESOLVER};
    resolver_timeout 5s;

    # Log format for HTTP proxy
    log_format http_proxy '[$time_local] '
                         '[$http_access_decision] '
                         'HTTP $status $body_bytes_sent $request_length '
                         '$request_time "$host:$server_port"';

    access_log /dev/stdout http_proxy;
    error_log /var/log/nginx/error_http.log;

    # HTTP - Allowlist map (with wildcard support)
    map $host $is_allowed_http {
        hostnames;
        # Dynamically generated allowlist (for HTTP)
${NGINX_HTTP_ALLOWED_MAP}
        # Default behavior
        default                     ${NGINX_HTTP_DEFAULT_ALLOWED};
    }

    # HTTP - Log the allow/block/audit decision result
    map $is_allowed_http $http_access_decision {
        0       "BLOCKED";
        default "${NGINX_ACCESS_DECISION}";
    }

    # Standard HTTP proxy server
    server {
${NGINX_HTTP_LISTEN_DEFAULT}

        # HTTP proxy
        location / {
            # Block check
            if ($is_allowed_http = "0") {
                return 502 "Blocked\n";
            }

            # Preserve request headers
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Proxy to backend (forward to the same port as the incoming request)
            proxy_pass http://$host:$server_port;
            proxy_read_timeout 10s;
            proxy_send_timeout 10s;
            proxy_connect_timeout 5s;
        }
    }

    # Localhost-only server (for health checks)
    server {
${NGINX_HTTP_LISTEN}
        server_name localhost 127.0.0.1;

        # Health check
        location /health {
            access_log off;
            return 200 "OK\n";
            add_header Content-Type text/plain;
        }
    }
}
