#!/command/with-contenv sh
set -e

GATEWAY=198.19.255.1

echo "init-cfg: proxy_mode=${PROXY_MODE:-restrict}"

# Addresses the runner itself holds, refused as a resolved destination by the
# generated internal-address acl. HOST_ADDRESSES is what the action read off the
# runner; the routing table adds the compose network's gateway, a runner address
# the action could not see yet. The container's own addresses keep a name
# Docker's DNS resolves to it (its service or container name) from looping the
# proxy into itself. A file because HAProxy refuses to start on an acl line past
# MAX_LINE_ARGS words.
HOST_ADDR_FILE=/etc/haproxy/rules/host_addrs.lst
mkdir -p /etc/haproxy/rules
{
    for addr in $HOST_ADDRESSES; do echo "$addr"; done
    ip -4 route show | awk '{ for (i = 1; i < NF; i++) if ($i == "via") print $(i + 1) }'
    ip -4 -o addr show scope global | awk '{ sub("/.*", "", $4); print $4 }'
} | sort -u > "$HOST_ADDR_FILE"
echo "init-cfg: guarded runner addresses=$(tr '\n' ' ' < "$HOST_ADDR_FILE")"

# CoreDNS's s6 unit depends on this oneshot too, for its Corefile.
qjs --std -m /opt/buildcage/scripts/gen-configs.js \
    /etc/haproxy/haproxy.cfg \
    /etc/coredns/Corefile \
    "$GATEWAY" \
    "$HOST_ADDR_FILE" \
    "${PROXY_MODE:-restrict}" \
    "$ALLOWED_HTTPS_RULES" \
    "$ALLOWED_HTTP_RULES" \
    "$ALLOWED_IP_RULES"

echo "init-cfg: configuration generated"
