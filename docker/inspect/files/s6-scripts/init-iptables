#!/command/with-contenv sh
set -e

PORT=10024

# Everything TCP goes to the one listener, which decides for itself whether it
# is looking at a handshake or a plain request. Nothing has to be declared as
# one or the other, which is what lets an audit run record traffic it was never
# configured for.
# A resolver falling back to TCP (a truncated answer, a large TXT or DNSSEC
# record) goes to CoreDNS: the TLS/HTTP classifier cannot read a DNS query.
# Only the gateway's own :53, so TCP to any other resolver is still redirected,
# judged by allowed_ip_rules and logged.
iptables -t nat -A PREROUTING -i buildcage0 -p tcp -d 198.19.255.1 --dport 53 -j RETURN
iptables -t nat -A PREROUTING -i buildcage0 -p tcp -j REDIRECT --to-ports "$PORT"

# Reaching the proxy and the resolver is all a step may do with the gateway.
# lo carries the services' own readiness checks, and without the conntrack rule
# the proxy's own outbound connections never see their replies. Those replies
# never arrive on buildcage0, so a step cannot pass itself off as one.
# Policy last, so nothing is dropped while the ACCEPTs are still going in.
iptables -A INPUT -i lo -j ACCEPT
iptables -A INPUT ! -i buildcage0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
iptables -A INPUT -i buildcage0 -p tcp --dport "$PORT" -j ACCEPT
iptables -A INPUT -i buildcage0 -p udp --dport 53 -j ACCEPT
iptables -A INPUT -i buildcage0 -p tcp --dport 53 -j ACCEPT
iptables -P INPUT DROP

# Nothing is routed onward, so a packet that escaped redirection goes nowhere.
iptables -P FORWARD DROP

# /proc/net/if_inet6 only exists when the kernel has IPv6 support compiled in
# and active. If it's absent, no IPv6 traffic can occur at all, so skipping
# ip6tables is safe. If it's present, ip6tables must succeed: set -e keeps
# this fail-closed rather than silently leaving IPv6 unfiltered.
#
# No gateway ports here: buildcage0 is IPv4-only, so nothing may reach
# the listeners over IPv6. ICMPv6 stays open for neighbour discovery.
if [ -e /proc/net/if_inet6 ]; then
    ip6tables -A INPUT -i lo -j ACCEPT
    ip6tables -A INPUT ! -i buildcage0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    ip6tables -A INPUT -p icmpv6 -j ACCEPT
    ip6tables -P INPUT DROP
    ip6tables -P FORWARD DROP
    echo "init-iptables: configured (IPv4/IPv6)"
else
    echo "init-iptables: configured (IPv4; kernel has no IPv6 support)"
fi
