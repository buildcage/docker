#!/command/with-contenv sh
set -e

GATEWAY=198.19.255.1

echo "init-inspect-cfg: proxy_mode=${PROXY_MODE:-restrict}"

# A fresh CA per container. The private key stays here, in a 600 file HAProxy
# signs per-SNI certificates with; only the certificate is published, at
# /opt/buildcage/ca.pem, for the caller to install into the workload. It is
# short-lived so a copy that escapes cleanup soon stops being trusted, and the
# random serialNumber makes its subject unique to this run.
if [ ! -f /etc/haproxy/ca.pem ]; then
    echo "init-inspect-cfg: generating the proxy CA"
    openssl req -x509 -newkey rsa:2048 -nodes -days 2 \
      -keyout /tmp/ca.key -out /tmp/ca.crt \
      -subj "/CN=buildcage proxy CA/serialNumber=$(openssl rand -hex 16)" \
      -addext "basicConstraints=critical,CA:TRUE" 2>/dev/null
    cat /tmp/ca.crt /tmp/ca.key > /etc/haproxy/ca.pem
    cp /tmp/ca.crt /opt/buildcage/ca.pem

    # Chromium trusts only its built-in roots and the NSS database in $HOME, so
    # this CA-only database is mounted over the workload's own. NSS_TRUST_TYPE=NSS
    # keeps the trust where older NSS (Debian 12, Ubuntu 24.04) can read it.
    rm -rf /opt/buildcage/nssdb
    mkdir -p /opt/buildcage/nssdb
    NSS_TRUST_TYPE=NSS certutil -N -d sql:/opt/buildcage/nssdb --empty-password
    NSS_TRUST_TYPE=NSS certutil -A -d sql:/opt/buildcage/nssdb -n "buildcage proxy CA" -t "C,," -i /tmp/ca.crt

    # The default certificate is the template every generated one is based on,
    # so it has to be a server certificate signed by the CA. Pointing it at the
    # CA itself makes the first handshake for each name fail.
    openssl req -newkey rsa:2048 -nodes -keyout /tmp/d.key -out /tmp/d.csr \
      -subj "/CN=buildcage-default" 2>/dev/null
    openssl x509 -req -in /tmp/d.csr -CA /tmp/ca.crt -CAkey /tmp/ca.key \
      -CAcreateserial -days 2 -out /tmp/d.crt 2>/dev/null
    cat /tmp/d.crt /tmp/d.key > /etc/haproxy/default.pem
    rm -f /tmp/ca.key /tmp/d.key /tmp/d.csr
fi
chmod 600 /etc/haproxy/ca.pem /etc/haproxy/default.pem

# Test-only, and only in an image built with BUILDCAGE_TEST_HOOKS: trust one
# more CA when verifying an origin. A released image has no marker file, so
# setting the variable there does nothing.
if [ -f /opt/buildcage/.test-hooks ] && [ -n "$BUILDCAGE_EXTRA_CA_FILE" ]; then
    echo "init-inspect-cfg: WARNING test build, trusting $BUILDCAGE_EXTRA_CA_FILE as a CA"
    cat "$BUILDCAGE_EXTRA_CA_FILE" >> /etc/ssl/certs/ca-certificates.crt
fi

# Addresses the runner itself holds, refused as a resolved destination by the
# generated internal-address acl. HOST_ADDRESSES is what the action read off the
# runner; the routing table adds the compose network's gateway, a runner address
# the action could not see yet. The container's own addresses keep a name
# Docker's DNS resolves to it (its service or container name) from looping the
# proxy into itself. A file because HAProxy refuses to start on an acl line past
# MAX_LINE_ARGS words.
HOST_ADDR_FILE=/etc/haproxy/rules/host_addrs.lst
mkdir -p /etc/haproxy/rules
{
    for addr in $HOST_ADDRESSES; do echo "$addr"; done
    ip -4 route show | awk '{ for (i = 1; i < NF; i++) if ($i == "via") print $(i + 1) }'
    ip -4 -o addr show scope global | awk '{ sub("/.*", "", $4); print $4 }'
} | sort -u > "$HOST_ADDR_FILE"
echo "init-inspect-cfg: guarded runner addresses=$(tr '\n' ' ' < "$HOST_ADDR_FILE")"

# audit has no allowlist to pass on; the generators decide what the mode means.
if [ "$PROXY_MODE" = "audit" ]; then
    HTTPS_RULES=""
    HTTP_RULES=""
    URL_RULES=""
else
    HTTPS_RULES="$ALLOWED_HTTPS_RULES"
    HTTP_RULES="$ALLOWED_HTTP_RULES"
    URL_RULES="$ALLOWED_URL_RULES"
fi

# Only the integration tests name an upstream; when it is unset, HAProxy reads
# the container's own /etc/resolv.conf, so a name resolves against the runner's
# own DNS rather than a hardcoded public one. Each entry is substituted into
# the generated resolvers section verbatim, so a value that is not an address
# is refused here rather than left to open a directive of its own in that file.
UPSTREAM_RESOLVERS=$(echo "$EXTERNAL_RESOLVER" | tr ',' ' ')
for ip in $UPSTREAM_RESOLVERS; do
    if ! echo "$ip" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}$'; then
        echo "init-inspect-cfg: EXTERNAL_RESOLVER takes IPv4 addresses; \"$ip\" is not one" >&2
        exit 1
    fi
done

if [ -z "$UPSTREAM_RESOLVERS" ]; then
    echo "init-inspect-cfg: resolver=(default, via /etc/resolv.conf)"
else
    echo "init-inspect-cfg: resolver=$UPSTREAM_RESOLVERS"
fi

qjs --std -m /opt/buildcage/scripts/gen-configs.js \
    /etc/haproxy/haproxy.cfg \
    /etc/coredns/Corefile \
    "$GATEWAY" \
    "$HOST_ADDR_FILE" \
    "$UPSTREAM_RESOLVERS" \
    "${PROXY_MODE:-restrict}" \
    "$HTTPS_RULES" \
    "$HTTP_RULES" \
    "$ALLOWED_IP_RULES" \
    "$ALLOWED_TLS_RULES" \
    "$URL_RULES"

echo "init-inspect-cfg: configuration generated"
