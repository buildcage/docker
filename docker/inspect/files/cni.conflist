{
  "cniVersion": "1.0.0",
  "name": "isolated-net",
  "plugins": [
    {
      "type": "bridge",
      "bridge": "buildcage0",
      "isGateway": true,
      "ipMasq": false,
      "portIsolation": true,
      "ipam": {
        "type": "host-local",
        "ranges": [[{
          "subnet": "198.19.255.0/24",
          "rangeStart": "198.19.255.100",
          "rangeEnd": "198.19.255.200",
          "gateway": "198.19.255.1"
        }]],
        "routes": [
          { "dst": "0.0.0.0/0" }
        ]
      },
      "dns": {
        "nameservers": ["198.19.255.1"]
      }
    }
  ]
}
