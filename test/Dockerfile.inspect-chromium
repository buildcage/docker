# Each step loads a page through the proxy in chrome-headless-shell, the build
# Puppeteer, Playwright and Remotion download, and fails unless it trusts the
# proxy CA through the slot the wrapper adds to the step's own NSS database
# (nssdb.go). Between them, the steps also check that the database stays the
# step's own: a CA written in one step is there in the next, and verifies a
# server that never goes through the proxy.
# Chrome for Testing ships it for x86-64 only, so the Makefile builds this for
# linux/amd64.
#
# FROM is deliberately not governed by this engine
# (see docs/security.md#what-buildkitd-fetches-itself), so this pull
# succeeds whatever the rules say.
FROM node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6

SHELL ["/bin/sh", "-c"]

ARG CHROME_VERSION=154.0.8037.57
ENV CHROME_HEADLESS_SHELL=/opt/chrome/chrome-headless-shell/linux-${CHROME_VERSION}/chrome-headless-shell-linux64/chrome-headless-shell

# Debian, because chrome-headless-shell needs glibc. Its NSS 3.87 is older than
# the proxy's certutil, which is the pairing that has to work. libnss3-tools
# is certutil and modutil, for the steps that write to the database.
RUN apt-get update && \
    apt-get install -y --no-install-recommends unzip openssl libnss3-tools \
      libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libdbus-1-3 \
      libexpat1 libgbm1 libglib2.0-0 libnspr4 libnss3 libudev1 libx11-6 \
      libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 \
      libxrandr2 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/check
COPY chromium/ ./
RUN npm ci --no-audit --no-fund && \
    npx --no-install browsers install "chrome-headless-shell@${CHROME_VERSION}" --path /opt/chrome && \
    test -x "$CHROME_HEADLESS_SHELL"

# A CA of the image's own and a server certificate it signed, for a server the
# steps run on loopback, which the proxy never sees: only the step's own
# database can make Chromium trust it.
RUN mkdir /opt/own-ca && cd /opt/own-ca && \
    openssl req -x509 -newkey rsa:2048 -nodes -keyout ca.key -out ca.pem -days 2 \
      -subj "/CN=the image's own CA" -addext basicConstraints=critical,CA:TRUE \
      -addext keyUsage=critical,keyCertSign 2>/dev/null && \
    openssl req -newkey rsa:2048 -nodes -keyout server.key -out server.csr -subj "/CN=localhost" 2>/dev/null && \
    printf 'subjectAltName=DNS:localhost\nextendedKeyUsage=serverAuth\n' > ext && \
    openssl x509 -req -in server.csr -CA ca.pem -CAkey ca.key -CAcreateserial -days 2 \
      -out server.pem -extfile ext 2>/dev/null && \
    rm ca.key server.csr ext && chmod 644 *

# A home the wrapper did not cover must be refused, so the check can fail.
RUN echo "=== [control: a home the wrapper did not cover] ===" && \
    mkdir -p /tmp/control && \
    HOME=/tmp/control node chromium-check.js https://allowed.example.com/public/chromium untrusted && \
    rm -rf /tmp/control && \
    echo "OK: refused without the database"

# With no database at all, the wrapper creates the legacy one every Chromium
# reads, and Chromium fills it; the image keeps that, less the slot.
RUN echo "=== [root, no database] ===" && \
    node chromium-check.js https://allowed.example.com/public/chromium && \
    node own-ca-server.js node chromium-check.js https://localhost:9443/ untrusted && \
    echo "OK: trusted the proxy CA, and not yet the image's own"

# What a step writes to the database is there for the next one.
RUN echo "=== [root, a CA of the image's own written to the database] ===" && \
    certutil -A -d sql:/root/.pki/nssdb -n own-ca -t "C,," -i /opt/own-ca/ca.pem && \
    echo | modutil -force -dbdir sql:/root/.pki/nssdb -add own-module \
      -libfile /usr/lib/x86_64-linux-gnu/libnssckbi.so && \
    echo "OK: wrote to the database"
RUN echo "=== [root, the database the previous step wrote] ===" && \
    certutil -L -d sql:/root/.pki/nssdb -n own-ca >/dev/null && \
    grep -q own-module /root/.pki/nssdb/pkcs11.txt && \
    node chromium-check.js https://allowed.example.com/public/chromium && \
    node own-ca-server.js node chromium-check.js https://localhost:9443/ && \
    echo "OK: trusted the proxy CA and the image's own, and kept the module"

# HOME comes from /etc/passwd, and a database only in the XDG path, which
# Chromium M146 and later read when there is no legacy one, is the one used.
RUN useradd -m app
USER app
RUN mkdir -p /home/app/.local/share/pki/nssdb && \
    certutil -N -d sql:/home/app/.local/share/pki/nssdb --empty-password && \
    certutil -A -d sql:/home/app/.local/share/pki/nssdb -n own-ca -t "C,," -i /opt/own-ca/ca.pem
RUN echo "=== [a user of its own, HOME from /etc/passwd, an XDG database] ===" && \
    node chromium-check.js https://allowed.example.com/public/chromium && \
    node own-ca-server.js node chromium-check.js https://localhost:9443/ && \
    echo "OK: trusted the proxy CA and the image's own"

# A database the step's user cannot write takes no slot, so Chromium does not
# trust the proxy CA.
USER root
RUN useradd -m reader && mkdir -p /home/reader/.pki/nssdb && \
    certutil -N -d sql:/home/reader/.pki/nssdb --empty-password && \
    chmod -R a+rX /home/reader/.pki
USER reader
RUN echo "=== [a database the user cannot write] ===" && \
    node chromium-check.js https://allowed.example.com/public/chromium untrusted && \
    echo "OK: refused without a slot"

# A copy of a home with no database takes no pkcs11.txt with it.
USER root
RUN useradd -m copier
USER copier
RUN cp -a /home/copier /tmp/home-copy

USER root
RUN echo "=== End of test ==="
