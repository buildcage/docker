FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1

RUN echo "=== DNS Configuration ===" && \
    cat /etc/resolv.conf

RUN echo "=== [HTTPS - any domain] ===" && \
    echo "Testing blocked.example.com (HTTPS, should be allowed in audit mode)..." && \
    (wget --no-check-certificate -q -O /dev/null --timeout=10 https://blocked.example.com/ && echo "✓ blocked.example.com: OK") || (echo "✗ blocked.example.com: FAILED" && exit 1)

RUN echo "=== [HTTP - any domain] ===" && \
    echo "Testing blocked.example.com (HTTP, should be allowed in audit mode)..." && \
    (wget -q -O /dev/null --timeout=10 http://blocked.example.com/ && echo "✓ blocked.example.com HTTP: OK") || (echo "✗ blocked.example.com HTTP: FAILED" && exit 1)

RUN echo "=== [Port 8443 - any domain] ===" && \
    echo "Testing blocked.example.com:8443 (HTTPS, should be allowed in audit mode)..." && \
    (wget --no-check-certificate -q -O /dev/null --timeout=10 https://blocked.example.com:8443/ && echo "✓ blocked.example.com:8443: OK") || (echo "✗ blocked.example.com:8443: FAILED" && exit 1)

RUN echo "=== [Port 8080 - any domain] ===" && \
    echo "Testing blocked.example.com:8080 (HTTP, should be allowed in audit mode)..." && \
    (wget -q -O /dev/null --timeout=10 http://blocked.example.com:8080/ && echo "✓ blocked.example.com:8080: OK") || (echo "✗ blocked.example.com:8080: FAILED" && exit 1)

RUN echo "=== [Direct IP - audit mode] ===" && \
    echo "Testing direct IP access to 10.200.0.100 (routed through haproxy via TPROXY)..." && \
    (wget -q -O /dev/null --timeout=5 http://10.200.0.100/ && echo "✓ 10.200.0.100: OK") || (echo "✗ 10.200.0.100: FAILED" && exit 1)

RUN echo "=== [HTTPS - SSRF via internal address] ===" && \
    echo "Testing internal.wildcard.example.com (HTTPS, should be blocked even in audit mode)..." && \
    (wget --no-check-certificate -q -O /dev/null --timeout=5 https://internal.wildcard.example.com/ && echo "✗ internal.wildcard.example.com: ALLOWED (unexpected)" && exit 1) || echo "✓ internal.wildcard.example.com: BLOCKED (expected)"

RUN echo "=== [HTTP - SSRF via internal address] ===" && \
    echo "Testing internal.wildcard.example.com (HTTP, should be blocked even in audit mode)..." && \
    (wget -q -O /dev/null --timeout=5 http://internal.wildcard.example.com/ && echo "✗ internal.wildcard.example.com HTTP: ALLOWED (unexpected)" && exit 1) || echo "✓ internal.wildcard.example.com HTTP: BLOCKED (expected)"

RUN echo "=== [HTTPS - SSRF back to the runner] ===" && \
    echo "Testing runner.wildcard.example.com (HTTPS, should be blocked even in audit mode)..." && \
    (wget --no-check-certificate -q -O /dev/null --timeout=5 https://runner.wildcard.example.com/ && echo "✗ runner.wildcard.example.com: ALLOWED (unexpected)" && exit 1) || echo "✓ runner.wildcard.example.com: BLOCKED (expected)"

RUN echo "=== [HTTP - SSRF back to the runner] ===" && \
    echo "Testing runner.wildcard.example.com (HTTP, should be blocked even in audit mode)..." && \
    (wget -q -O /dev/null --timeout=5 http://runner.wildcard.example.com/ && echo "✗ runner.wildcard.example.com HTTP: ALLOWED (unexpected)" && exit 1) || echo "✓ runner.wildcard.example.com HTTP: BLOCKED (expected)"

RUN echo "=== [HTTPS - dns-failed] ===" && \
    echo "Testing nxdomain.wildcard.example.com (HTTPS, should be blocked by dns failure)..." && \
    (wget --no-check-certificate -q -O /dev/null --timeout=5 https://nxdomain.wildcard.example.com/ && echo "✗ nxdomain.wildcard.example.com: ALLOWED (unexpected)" && exit 1) || echo "✓ nxdomain.wildcard.example.com: BLOCKED (expected)"

RUN echo "=== [HTTP - dns-failed] ===" && \
    echo "Testing nxdomain.wildcard.example.com (HTTP, should be blocked by dns failure)..." && \
    (wget -q -O /dev/null --timeout=5 http://nxdomain.wildcard.example.com/ && echo "✗ nxdomain.wildcard.example.com HTTP: ALLOWED (unexpected)" && exit 1) || echo "✓ nxdomain.wildcard.example.com HTTP: BLOCKED (expected)"

RUN echo "=== [HTTPS - missing-sni] ===" && \
    echo "Testing TLS connection without SNI (should be blocked)..." && \
    (printf '\x16\x03\x01\x00\x2d\x01\x00\x00\x29\x03\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\xff\x01\x00' | nc -w 5 allowed.example.com 443 > /dev/null 2>&1 || true) && \
    echo "✓ missing-sni: request sent (blocked expected in logs)"

RUN echo "=== [HTTP - missing-host-header] ===" && \
    echo "Testing HTTP request without Host header (should be blocked)..." && \
    ((printf 'GET / HTTP/1.0\r\n\r\n'; sleep 1) | nc -w 5 allowed.example.com 80 > /dev/null 2>&1 || true) && \
    echo "✓ missing-host-header: request sent (blocked expected in logs)"

# What a resolver does when a UDP answer comes back truncated. The query has to
# reach the resolver itself, not the proxy, which cannot read one.
RUN echo "=== [DNS over TCP] ===" && \
    echo "Testing a TCP lookup at the resolver (should be answered)..." && \
    node -e ' \
      const q = Buffer.from("abcd01000001000000000000076578616d706c6503636f6d0000010001", "hex"); \
      const len = Buffer.alloc(2); len.writeUInt16BE(q.length); \
      const s = require("net").connect(53, "198.19.255.1", () => s.write(Buffer.concat([len, q]))); \
      const done = (ok, why) => { console.log(ok ? "✓ DNS over TCP: answered" : `✗ DNS over TCP: ${why}`); process.exit(ok ? 0 : 1); }; \
      s.setTimeout(5000, () => done(false, "timed out")); \
      s.on("error", (e) => done(false, e.message)); \
      s.on("end", () => done(false, "closed without an answer")); \
      s.on("data", (d) => done(d.length >= 14 && d.readUInt16BE(2) === 0xabcd, "not an answer to the query")); \
    '

RUN echo "=== Network Configuration ===" && \
    ip route show && \
    echo "=== End of test ==="
