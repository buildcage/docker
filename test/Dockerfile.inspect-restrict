# curl rather than busybox wget: this engine's assertions are about methods and
# response bodies, and busybox wget can send neither a POST nor report a status.
# This image was picked because it ships curl already: installing curl would
# need a package mirror in the allowlist and make every case depend on a
# public CDN.
#
# FROM is deliberately not governed by this engine
# (see docs/security.md#what-buildkitd-fetches-itself), so this pull
# succeeds whatever the rules say.
FROM alpine/curl@sha256:1a4d725751c5bd50297ee243db5d4df8ac5aabdf7030dd40dcec3bc3fdaa1cfa

SHELL ["/bin/sh", "-c"]

# Rules under test: see fixture-rules-inspect.sh. The runc wrapper puts the
# proxy's CA in the system store for each step, which the scenarios rely on.
COPY scenarios/ /scenarios/
RUN sh /scenarios/inspect-restrict.sh

# apk (like apt/yum) trusts whatever OpenSSL's system store trusts rather than
# a store of its own. Reusing /public/** as a fake index only exercises the
# TLS leg: a file-format error proves the handshake (and the rule) passed,
# while "not trusted" is what an uninjected CA would say instead.
RUN echo "=== [Package manager - apk over the injected CA] ===" && \
    echo "https://allowed.example.com/public" > /etc/apk/repositories && \
    OUT=$(apk update 2>&1); \
    echo "$OUT" && \
    case "$OUT" in \
      *"not trusted"*) echo "FAILED: TLS was not trusted" && exit 1 ;; \
      *) echo "OK: reached the origin over TLS" ;; \
    esac

# The CA reaches the layer without the wrapper writing it there: a step that
# copies the store carries it out of the one directory the undo knows about.
# Only reading the step's own layer back finds this.
# assert-inspect-no-ca-residue.sh checks the copy in the built image.
RUN echo "=== [A copy of the store outside it] ===" && \
    mkdir -p /app && \
    cp /etc/ssl/certs/ca-certificates.crt /app/bundle.pem && \
    echo "OK: copied"

RUN echo "=== End of test ==="
