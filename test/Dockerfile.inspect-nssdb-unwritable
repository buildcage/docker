# An NSS database the step's user cannot write takes no slot, and the step
# warns instead of failing.
#
# FROM is deliberately not governed by this engine
# (see docs/security.md#what-buildkitd-fetches-itself), so this pull
# succeeds whatever the rules say.
FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

SHELL ["/bin/sh", "-c"]

RUN adduser -D app && mkdir -p /home/app/.pki/nssdb
USER app
RUN test -z "$(ls -A /home/app/.pki/nssdb)" && ! test -e /dev/buildcage-nssdb
