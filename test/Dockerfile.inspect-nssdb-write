# The wrapper binds a database holding only the proxy CA over the step's own
# NSS database (see Dockerfile.inspect-chromium). A step that writes to it
# changes a file buildcage replaced, whose change has nowhere true to go back
# to, so the build must fail and say why rather than commit or drop the write,
# unless fail_on_ca_residue is false, when it warns and drops it.
#
# FROM is deliberately not governed by this engine
# (see docs/security.md#what-buildkitd-fetches-itself), so this pull
# succeeds whatever the rules say.
FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

SHELL ["/bin/sh", "-c"]

RUN touch /root/.local/share/pki/nssdb/written-by-the-step
