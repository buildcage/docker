# apt is the default package manager on the most common Linux base image
# family, and unlike Node/Python/Ruby it has no CA store of its own: it
# trusts whatever the OS provides. Debian's own slim image ships with none
# until ca-certificates is installed, which the first RUN step below does.
# That step itself gets no CA from the wrapper, because there is no store yet
# for it to add to, but the real Debian archive is plain HTTP by default, so
# nothing here needs one: apt authenticates packages by the archive's GPG key
# (already present via debian-archive-keyring), never by TLS.
#
# Both modes build this same Dockerfile, so it is where the suite checks
# that audit injects the CA too: audit enforces nothing, but it still
# terminates TLS, so a package manager has to get past the handshake either
# way. The Alpine images check the same thing under restrict alone, which
# is the split no-ca-residue and no-layer-bloat already use.
#
# FROM is deliberately not governed by this engine
# (see docs/security.md#what-buildkitd-fetches-itself), so this pull
# succeeds whatever the rules say.
FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

SHELL ["/bin/sh", "-c"]

RUN echo "=== [apt bootstrap: ca-certificates over plain HTTP] ===" && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    echo "OK"

# The JVM keeps its trusted roots in a keystore of its own, a JKS at a path that
# holds the JDK's vendor and version, so no list of paths would name it and no
# PEM removal reaches it: this is the case the layer sweep's keystore rewrite
# exists for. A JRE brings keytool, and the anchor the wrapper placed this step
# is imported into that keystore the way ca-certificates-java would, so the
# keystore ends the step trusting the CA. The in-step grep proves it does,
# before the sweep runs; assert-inspect-no-ca-residue.sh proves the committed
# image's keystore no longer does. A build that could not take it out would have
# failed rather than reached here.
#
# Installed here, while the apt sources are still only the plain-HTTP archive,
# before the later steps add a blocked one.
RUN echo "=== [JRE keystore over the injected CA] ===" && \
    apt-get install -y --no-install-recommends default-jre-headless && \
    keytool -importcert -noprompt -alias buildcage \
      -file /usr/local/share/ca-certificates/buildcage.crt \
      -keystore /etc/ssl/certs/java/cacerts -storepass changeit && \
    keytool -list -keystore /etc/ssl/certs/java/cacerts -storepass changeit | grep -qi buildcage && \
    echo "OK: the JVM keystore trusts the anchor in-step"

# A new layer starts with the ca-certificates.crt the previous step just
# created, so this step gets the wrapper's CA the normal way. Reusing
# /public/** as a fake index only exercises the TLS leg: a signature error
# proves the handshake (and the rule) passed, while a certificate error is
# what an uninjected CA would produce instead.
RUN echo "=== [apt over the injected CA] ===" && \
    echo "deb [trusted=yes] https://allowed.example.com/public/debian ./" \
      > /etc/apt/sources.list.d/inspect-test.list && \
    OUT=$(apt-get update 2>&1); CODE=$?; \
    echo "$OUT"; \
    case "$OUT" in \
      *"Certificate verification failed"*|*"NOT trusted"*|*"unable to get local issuer"*) \
        echo "FAILED: the injected CA was not trusted" && exit 1 ;; \
      *) echo "OK: reached the origin over TLS (exit=$CODE, a content error is expected)" ;; \
    esac

# The one request whose outcome depends on the mode: restrict blocks it at the
# proxy, audit records it and lets it reach the origin. Both modes run this same
# Dockerfile, so without it the two runs would assert nothing the other doesn't.
# apt's own exit code is not the subject here: either way it gets a body it
# cannot parse, so the assertions read the proxy log instead.
RUN echo "=== [apt outside the rules] ===" && \
    echo "deb [trusted=yes] https://allowed.example.com/private/debian ./" \
      > /etc/apt/sources.list.d/inspect-outside.list && \
    rm -f /etc/apt/sources.list.d/inspect-test.list && \
    apt-get update 2>&1 | tail -5; \
    echo "OK: request sent"

# A step that copies the store puts the CA somewhere no list of paths would
# name, so the copy is only found by reading the step's own layer back. Both
# shapes a trust store keeps a certificate in are made here: the plain PEM the
# bundle is, and the re-armoured TRUSTED CERTIFICATE that a RHEL rebuild
# writes, whose body is the certificate with trust settings appended and which
# therefore matches neither the original block nor its base64. openssl is
# already here, since ca-certificates depends on it.
#
# `-addtrust` is what makes the second one that shape. `-trustout` alone leaves
# the auxiliary trust info empty, and the body is then byte-identical to the
# plain block's, so the copy would be found by matching on equality and this
# would prove nothing about containment.
#
# The injected CA is the last block in the bundle, which the subject check
# confirms: without it a fixture that stopped copying the right certificate
# would still pass. assert-inspect-no-ca-residue.sh checks the built image.
RUN echo "=== [A copy of the store outside it] ===" && \
    mkdir -p /app && \
    cp /etc/ssl/certs/ca-certificates.crt /app/bundle.pem && \
    awk '/-----BEGIN CERTIFICATE-----/{c=""} {c=c $0 "\n"} /-----END CERTIFICATE-----/{last=c} \
         END{printf "%s", last}' /app/bundle.pem > /tmp/last.pem && \
    openssl x509 -in /tmp/last.pem -noout -subject | grep -q "buildcage proxy CA" && \
    openssl x509 -in /tmp/last.pem -trustout -addtrust serverAuth -out /app/trusted.pem && \
    echo "OK: copied"

RUN echo "=== End of test ==="
