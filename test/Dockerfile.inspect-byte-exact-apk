# Fixture for assert-inspect-byte-exact.sh, run beside Dockerfile.inspect-byte-exact.
# apk keeps a bundle under /etc that differs from its record, and inspect adds
# its CA to the bundle for each step, so an upgrade must still replace it as it
# would under any engine.
FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

# Records an older version, so the upgrade below happens whatever the
# repository holds by the time this runs.
RUN sed -i '/^P:ca-certificates-bundle$/,/^$/ s/^V:.*/V:0-r0/' /lib/apk/db/installed

# apk's log carries the time, and under inspect also the .apk-new the wrapper
# moves into place after the step.
RUN apk upgrade --no-cache ca-certificates-bundle && rm /var/log/apk.log
